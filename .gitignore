# ===== xgconsole side (console/page tooling) =====

# build-time scratch state, not source (e.g. tools/build_graph.py's
# persisted node-position store)
.console_build/

# xgpage package assets: web/assets theme/ui files are GENERATED by
# tools/sync_xgpage_assets.py from the standalone ~/studio/xgpage package —
# never hand-edit, never commit the generated bytes. model-viewer.min.js is
# the one exception: a hand-vendored pinned external library no script
# regenerates — KEEP it tracked.
xgconsole/web/assets/theme.css
xgconsole/web/assets/theme2.css
xgconsole/web/assets/theme3.css
xgconsole/web/assets/ui.js
xgconsole/web/assets/xg2.js
xgconsole/web/assets/xg3.js
xgconsole/web/assets/katex/

# ad-hoc QA screenshots at the repo root
/*.png
/*.jpg
/*.jpeg
/*.tar.gz

# secrets — never commit
*.env
.env*
*token*
*secret*
*.credentials.json
xgconsole/jobs/.locks/
captures/
