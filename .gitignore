# ===== lightgen-ops: personal console/xgpage/notes tooling =====
# Everything not explicitly the ops layer is ignored. Dev code lives in the
# dongchen-yang/lightgen team repo + the SegviGen-emissive submodule, NOT here.

# venvs (rebuildable)
.venv/
.venv_console/
.venv_itables/
**/.venv/
**/__pycache__/
*.pyc

# build-time scratch state, not source (e.g. tools/build_graph.py's
# persisted node-position store)
/.console_build/

# xgpage package assets (migrated 2026-07-22): web/assets/ is now GENERATED by
# tools/sync_xgpage_assets.py from the standalone ~/studio/xgpage package —
# never hand-edit, never commit the generated bytes (reproducible from the
# package + tools/xgpage_ext_assets/, both of which ARE tracked). model-viewer.min.js
# is the one exception: a hand-vendored external library (@google/model-viewer
# 3.5.0, pinned) the package does not ship and no script regenerates — KEEP it
# tracked, or it is unrecoverable if this local-scratch disk is lost (see the
# lightgen durability memory note).
/web/assets/theme.css
/web/assets/theme2.css
/web/assets/theme3.css
/web/assets/ui.js
/web/assets/xg2.js
/web/assets/xg3.js
/web/assets/katex/

# nested external repos — separately versioned, never vendor here
/lightgen_repo/
/TEXGen/
/diffusion-net/
/lightgen_overleaf/
/diffusionnet_light/
/cluster_skill/
/render_texverse/
/segvigen_emissive/code/

# heavy / generated / reproducible
/segvigen_emissive/vis_data/
/segvigen_emissive/direct_pilot/
/segvigen_emissive/pred_glb/
/segvigen_emissive/dump_*/
/segvigen_emissive/dataset/
/segvigen_emissive/outputs/
/segvigen_emissive/__pycache__/

# ad-hoc QA screenshots + binaries at the project root and elsewhere
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.tar.gz
*.glb
*.ckpt
*.pth
*.npz
*.blend

# secrets — never commit
*.env
.env*
*token*
*secret*
*.credentials.json
jobs/.locks/
captures/
